{
  "name": "relatives-remembered",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "kill-backend": "kill $(lsof -ti :3001) 2>/dev/null || true"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
