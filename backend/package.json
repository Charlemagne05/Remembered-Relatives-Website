{
  "name": "relatives-remembered-backend",
  "version": "1.0.0",
  "description": "Backend API for Relatives Remembered - memorial stories platform",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "nodemon --exec 'node --experimental-sqlite' server.js",
    "test": "node --experimental-sqlite node_modules/.bin/jest --runInBand"
  },
  "jest": {
    "setupFiles": [
      "./tests/setup.js"
    ],
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
